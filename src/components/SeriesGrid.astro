---
import StarIcon from './StarIcon.astro';

interface Serie {
  title: string;
  image: string;
  rating: number;
}

const MAX_RATING = 5;

const series: Serie[] = [
  { title: 'The Mentalist', image: 'https://image.tmdb.org/t/p/w500/acYXu4KaDj1NIkMgObnhe4C4a0T.jpg', rating: 5 },
  { title: 'The Walking Dead', image: 'https://image.tmdb.org/t/p/w500/ng3cMtxYKt1OSQYqFlnKWnVsqNO.jpg', rating: 5 },
  { title: 'The 100', image: 'https://image.tmdb.org/t/p/w500/wHIMMLFsk32wIzDmawWkYVbxFCS.jpg', rating: 5 },
  { title: 'Fear the Walking Dead', image: 'https://image.tmdb.org/t/p/w500/eKt4ELpQZUKGZCKIDobEbwHwk3I.jpg', rating: 4 },
];
---

<section class="mt-10 w-full">
  <div class="mb-4 flex items-center gap-2">
    <StarIcon filled class="h-5 w-5 text-amber-400" />
    <h2 class="font-display text-lg font-bold text-white">Series Favoritas</h2>
  </div>

  <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
    {series.map((serie) => (
      <article
        class="glass-card group overflow-hidden rounded-2xl transition-all duration-300 hover:-translate-y-1 hover:shadow-glow-violet"
      >
        <div class="relative aspect-[2/3] overflow-hidden">
          <img
            src={serie.image}
            alt={`Póster ${serie.title}`}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            width="400"
            height="600"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="p-4">
          <h3 class="font-display mb-1.5 text-sm font-semibold text-white">{serie.title}</h3>
          <div
            class="flex items-center gap-0.5 text-amber-400"
            aria-label={`${serie.rating} de ${MAX_RATING} estrellas`}
          >
            {Array.from({ length: MAX_RATING }, (_, index) => (
              <StarIcon
                filled={index < serie.rating}
                class:list={[
                  'h-3.5 w-3.5',
                  index < serie.rating ? 'text-amber-400' : 'text-slate-600',
                ]}
              />
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>