---
import { Icon } from 'astro-icon/components';

interface Props {
  name: string;
  tagline: string;
  href: string;
  icon: string;
  accent: 'green' | 'violet';
}

const { name, tagline, href, icon, accent } = Astro.props;

const accents = {
  green: {
    chip: 'bg-slate-900/90 border border-emerald-500/20 text-emerald-400',
    btn: 'bg-letterboxd hover:bg-emerald-400 text-slate-950',
    glow: 'hover:shadow-glow-green',
  },
  violet: {
    chip: 'bg-slate-900/90 border border-violet-500/20 text-violet-400',
    btn: 'bg-serializd hover:bg-violet-500 text-white',
    glow: 'hover:shadow-glow-violet',
  },
} as const;

const a = accents[accent];
---

<article
  class:list={[
    'glass-card flex flex-col gap-5 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 md:flex-row md:items-center md:justify-between',
    a.glow,
  ]}
>
  <div class="flex items-center gap-4">
    <div class:list={['rounded-xl p-3.5', a.chip]}>
      <Icon name={`lucide:${icon}`} class="h-7 w-7" />
    </div>
    <div>
      <h2 class="font-display text-xl font-bold text-white">{name}</h2>
      <p class="text-xs text-slate-400">{tagline}</p>
    </div>
  </div>

  <a
    href={href}
    target="_blank"
    rel="noreferrer"
    class:list={['flex items-center gap-2 rounded-xl px-5 py-3 text-sm font-bold', a.btn]}
  >
    <span>Ver Perfil</span>
    <Icon name="lucide:arrow-up-right" class="h-4 w-4" />
  </a>
</article>